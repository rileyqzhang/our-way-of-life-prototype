# Copy this file to `.env.local` for local development.
# On Vercel, set the same names in Project Settings → Environment Variables.
# Never commit real keys.

# Sanity Content Lake. Leave the project id blank to keep using the local timeline JSON.
NEXT_PUBLIC_SANITY_PROJECT_ID=b7ojtu3l
NEXT_PUBLIC_SANITY_DATASET=production
# Viewer token for draft preview. Server only.
SANITY_API_READ_TOKEN=
# Editor token used only by `npm run sanity:import`. Server only. Do not add this to the website runtime.
SANITY_API_WRITE_TOKEN=
# Optional. Presentation tool opens this URL. Vercel preview URLs work here.
SANITY_STUDIO_PREVIEW_URL=http://localhost:3001

# Shared Google Doc for the For Research transcripts page.
NEXT_PUBLIC_RESEARCH_DOC_URL=
# Address used by the email button on Share Your Story. Sanity site settings can override this.
NEXT_PUBLIC_CONTACT_EMAIL=

# Frozen. Story intake is paused until privacy review. These are not the public content database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
